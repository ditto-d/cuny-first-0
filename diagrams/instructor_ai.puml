@startuml


skinparam sequenceArrowThickness 2
skinparam ParticipantPadding 20
skinparam sequenceFontSize 12

actor Instructor
participant "System" as SYS
participant "Backend" as BE
database "Instructor Records" as IR
database "Vector DB\n(Instructor-Allowed Context)" as VDB
participant "LLM Service" as LLM

Instructor -> SYS : submit question
SYS -> BE : process_instructor_query(instructor_id, question)
BE -> IR : retrieve assigned classes(instructor_id)
IR --> BE : assigned class list
BE -> BE : restrict context to assigned classes\nand students in those classes
BE -> VDB : search_allowed_context(question, assigned_classes)

alt local answer found
    VDB --> BE : local answer
    BE --> SYS : answer from local information
    SYS --> Instructor : display answer
else question outside allowed context
    VDB --> BE : restricted or unauthorized context
    BE --> SYS : access-limited response
    SYS --> Instructor : display restricted answer message
else no local answer found
    VDB --> BE : no answer found
    BE -> LLM : send question for possible answer

    alt LLM returns answer
        LLM --> BE : possible answer
        BE --> SYS : answer + hallucination warning
        SYS --> Instructor : display answer with warning
    else LLM fails
        LLM --> BE : error
        BE --> SYS : unable-to-answer message
        SYS --> Instructor : display fallback message
    end
end

@enduml
